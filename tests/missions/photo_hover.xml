<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="take_off" id="ph_takeoff" x="20" y="20">
    <value name="ALT"><shadow type="math_number" id="ph_alt"><field name="NUM">1</field></shadow></value>
    <field name="WAIT">TRUE</field>
    <next>
      <block type="hover" id="ph_hover">
        <value name="ALTITUDE"><shadow type="math_number" id="ph_hoveralt"><field name="NUM">2.5</field></shadow></value>
        <next>
          <block type="take_photo" id="ph_photo">
            <next><block type="land" id="ph_land"><field name="WAIT">TRUE</field></block></next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
