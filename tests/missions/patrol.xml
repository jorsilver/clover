<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="take_off" id="pt_takeoff" x="20" y="20">
    <value name="ALT"><shadow type="math_number" id="pt_alt"><field name="NUM">2</field></shadow></value>
    <field name="WAIT">TRUE</field>
    <next>
      <block type="patrol_route" id="pt_route">
        <value name="WAYPOINTS">
          <block type="lists_create_with" id="pt_list">
            <mutation items="3"></mutation>
            <value name="ADD0">
              <block type="waypoint" id="pt_wp1">
                <value name="X"><shadow type="math_number" id="pt_x1"><field name="NUM">2</field></shadow></value>
                <value name="Y"><shadow type="math_number" id="pt_y1"><field name="NUM">0</field></shadow></value>
                <value name="Z"><shadow type="math_number" id="pt_z1"><field name="NUM">2</field></shadow></value>
              </block>
            </value>
            <value name="ADD1">
              <block type="waypoint" id="pt_wp2">
                <value name="X"><shadow type="math_number" id="pt_x2"><field name="NUM">2</field></shadow></value>
                <value name="Y"><shadow type="math_number" id="pt_y2"><field name="NUM">2</field></shadow></value>
                <value name="Z"><shadow type="math_number" id="pt_z2"><field name="NUM">2</field></shadow></value>
              </block>
            </value>
            <value name="ADD2">
              <block type="waypoint" id="pt_wp3">
                <value name="X"><shadow type="math_number" id="pt_x3"><field name="NUM">0</field></shadow></value>
                <value name="Y"><shadow type="math_number" id="pt_y3"><field name="NUM">2</field></shadow></value>
                <value name="Z"><shadow type="math_number" id="pt_z3"><field name="NUM">2</field></shadow></value>
              </block>
            </value>
          </block>
        </value>
        <value name="REPEAT"><shadow type="math_number" id="pt_rep"><field name="NUM">2</field></shadow></value>
        <next><block type="land" id="pt_land"><field name="WAIT">TRUE</field></block></next>
      </block>
    </next>
  </block>
</xml>
