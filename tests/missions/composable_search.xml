<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="take_off" id="cs_takeoff" x="20" y="20">
    <value name="ALT"><shadow type="math_number" id="cs_alt"><field name="NUM">2</field></shadow></value>
    <field name="WAIT">TRUE</field>
    <next>
      <block type="controls_if" id="cs_if">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="search_area" id="cs_search">
            <value name="X"><shadow type="math_number" id="cs_x"><field name="NUM">0</field></shadow></value>
            <value name="Y"><shadow type="math_number" id="cs_y"><field name="NUM">0</field></shadow></value>
            <value name="SIZE"><shadow type="math_number" id="cs_size"><field name="NUM">6</field></shadow></value>
          </block>
        </value>
        <statement name="DO0">
          <block type="track_target" id="cs_track">
            <value name="SECONDS"><shadow type="math_number" id="cs_secs"><field name="NUM">5</field></shadow></value>
            <next><block type="land" id="cs_land"><field name="WAIT">TRUE</field></block></next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="return_to_launch" id="cs_rtl">
            <value name="Z"><shadow type="math_number" id="cs_rtlz"><field name="NUM">0.5</field></shadow></value>
            <next><block type="land" id="cs_land2"><field name="WAIT">TRUE</field></block></next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>
